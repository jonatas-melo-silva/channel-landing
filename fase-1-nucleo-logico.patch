+++ b/tests/unit/preferences.test.ts
@@ -0,0 +1,82 @@
+import { describe, expect, it } from 'vitest';
+import {
+  getChannelPage,
+  sanitizePreferences,
+  setChannelPage,
+  type Preferences,
+} from '@/lib/preferences';
+
+describe('getChannelPage', () => {
+  it('usa Vídeos para canal sem preferência', () => {
+    expect(getChannelPage({}, '@x')).toBe('videos');
+  });
+
+  it('devolve a página salva', () => {
+    expect(getChannelPage({ '@x': 'posts' }, '@x')).toBe('posts');
+  });
+
+  it('usa Vídeos quando o valor salvo é inválido', () => {
+    expect(getChannelPage({ '@x': 'nope' } as unknown as Preferences, '@x')).toBe('videos');
+  });
+
+  it('não confunde o nome de um canal com propriedades de objeto', () => {
+    expect(getChannelPage({}, 'constructor')).toBe('videos');
+  });
+});
+
+describe('setChannelPage', () => {
+  it('grava a escolha de um canal', () => {
+    expect(setChannelPage({}, '@x', 'streams')).toEqual({ '@x': 'streams' });
+  });
+
+  it('troca a escolha anterior do mesmo canal', () => {
+    expect(setChannelPage({ '@x': 'streams' }, '@x', 'posts')).toEqual({ '@x': 'posts' });
+  });
+
+  it('escolher Vídeos remove a entrada do canal', () => {
+    expect(setChannelPage({ '@x': 'streams', '@y': 'posts' }, '@x', 'videos')).toEqual({
+      '@y': 'posts',
+    });
+  });
+
+  it('guardar Início conta como preferência', () => {
+    expect(setChannelPage({}, '@x', 'home')).toEqual({ '@x': 'home' });
+  });
+
+  it('não altera o objeto original', () => {
+    const original: Preferences = { '@x': 'streams' };
+    setChannelPage(original, '@x', 'videos');
+    setChannelPage(original, '@y', 'posts');
+    expect(original).toEqual({ '@x': 'streams' });
+  });
+});
+
+describe('sanitizePreferences', () => {
+  it.each([undefined, null, 'texto', 42, true, ['@x']])('devolve {} para %j', (raw) => {
+    expect(sanitizePreferences(raw)).toEqual({});
+  });
+
+  it('mantém entradas válidas', () => {
+    expect(sanitizePreferences({ '@x': 'streams', '@y': 'home' })).toEqual({
+      '@x': 'streams',
+      '@y': 'home',
+    });
+  });
+
+  it('descarta páginas desconhecidas e chaves que não são handle', () => {
+    expect(sanitizePreferences({ '@x': 'nope', lixo: 'streams', '@y': 'posts', '@z': 3 })).toEqual({
+      '@y': 'posts',
+    });
+  });
+
+  it('descarta Vídeos, que é o padrão e não precisa ficar salvo', () => {
+    expect(sanitizePreferences({ '@x': 'videos', '@y': 'posts' })).toEqual({ '@y': 'posts' });
+  });
+
+  it('normaliza as chaves', () => {
+    expect(sanitizePreferences({ '@KipperDev': 'streams', '@caf%C3%A9': 'posts' })).toEqual({
+      '@kipperdev': 'streams',
+      '@café': 'posts',
+    });
+  });
+});
diff --git a/tests/unit/redirect.test.ts b/tests/unit/redirect.test.ts
new file mode 100644
index 0000000..0a840fe
--- /dev/null
+++ b/tests/unit/redirect.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, it } from 'vitest';
+import { PAGES, getPage, type PageKey } from '@/lib/pages';
+import type { Preferences } from '@/lib/preferences';
+import { resolveTarget } from '@/lib/redirect';
+
+const YT = 'https://www.youtube.com';
+
+describe('resolveTarget sem preferência (padrão Vídeos)', () => {
+  it.each([
+    [`${YT}/@x`, `${YT}/@x/videos`],
+    [`${YT}/@x/`, `${YT}/@x/videos`],
+    [`${YT}/@x/featured`, `${YT}/@x/videos`],
+    [`${YT}/@x/featured/`, `${YT}/@x/videos`],
+    [`${YT}/@x?si=abc`, `${YT}/@x/videos?si=abc`],
+    [`${YT}/@x/?si=abc`, `${YT}/@x/videos?si=abc`],
+    [`${YT}/@x/featured?si=abc`, `${YT}/@x/videos?si=abc`],
+    [`${YT}/@x#topo`, `${YT}/@x/videos`],
+  ])('%s vai para %s', (url, expected) => {
+    expect(resolveTarget(url, {})).toBe(expected);
+  });
+
+  it('mantém o handle exatamente como veio na URL', () => {
+    expect(resolveTarget(`${YT}/@KipperDev`, {})).toBe(`${YT}/@KipperDev/videos`);
+    expect(resolveTarget(`${YT}/@caf%C3%A9`, {})).toBe(`${YT}/@caf%C3%A9/videos`);
+  });
+
+  it('aceita um objeto URL', () => {
+    expect(resolveTarget(new URL(`${YT}/@x`), {})).toBe(`${YT}/@x/videos`);
+  });
+});
+
+describe('resolveTarget com preferência', () => {
+  const pages = PAGES.filter((page) => page.key !== 'home').map((page) => page.key);
+
+  it.each(pages)('leva o canal para %s', (key) => {
+    const prefs: Preferences = { '@x': key };
+    expect(resolveTarget(`${YT}/@x`, prefs)).toBe(`${YT}/@x/${getPage(key).path}`);
+  });
+
+  it('ignora maiúsculas ao achar a preferência e mantém o handle da URL', () => {
+    expect(resolveTarget(`${YT}/@X`, { '@x': 'streams' })).toBe(`${YT}/@X/streams`);
+  });
+
+  it('não deixa a preferência de um canal vazar para outro', () => {
+    const prefs: Preferences = { '@x': 'streams' };
+    expect(resolveTarget(`${YT}/@y`, prefs)).toBe(`${YT}/@y/videos`);
+    expect(resolveTarget(`${YT}/@xy`, prefs)).toBe(`${YT}/@xy/videos`);
+    expect(resolveTarget(`${YT}/@x`, prefs)).toBe(`${YT}/@x/streams`);
+  });
+
+  it('usa Vídeos quando o valor salvo é inválido', () => {
+    const prefs = { '@x': 'nope' } as unknown as Preferences;
+    expect(resolveTarget(`${YT}/@x`, prefs)).toBe(`${YT}/@x/videos`);
+  });
+
+  it.each([`${YT}/@x`, `${YT}/@x/`, `${YT}/@x/featured`, `${YT}/@x?si=abc`])(
+    'preferência Início não redireciona %s',
+    (url) => {
+      expect(resolveTarget(url, { '@x': 'home' })).toBeNull();
+    },
+  );
+});
+
+describe('resolveTarget não mexe em outras páginas', () => {
+  it.each([
+    `${YT}/@x/videos`,
+    `${YT}/@x/streams`,
+    `${YT}/@x/playlists`,
+    `${YT}/@x/posts`,
+    `${YT}/@x/podcasts`,
+    `${YT}/@x/about`,
+    `${YT}/@x/community`,
+    `${YT}/@x/shorts`,
+    `${YT}/@x/search?query=a`,
+    `${YT}/@x/featured/extra`,
+    `${YT}/watch?v=abc`,
+    `${YT}/shorts/abc`,
+    `${YT}/`,
+    `${YT}/channel/UCabc`,
+    'https://example.com/@x',
+    'não é uma url',
+  ])('%s fica como está', (url) => {
+    expect(resolveTarget(url, {})).toBeNull();
+  });
+
+  it('não entra em loop: a aba escolhida não é redirecionada de novo', () => {
+    const key: PageKey = 'streams';
+    const prefs: Preferences = { '@x': key };
+    const target = resolveTarget(`${YT}/@x`, prefs);
+    expect(target).toBe(`${YT}/@x/streams`);
+    expect(resolveTarget(target ?? '', prefs)).toBeNull();
+  });
+
+  it('deixa o usuário abrir outra aba mesmo com preferência diferente', () => {
+    expect(resolveTarget(`${YT}/@x/videos`, { '@x': 'streams' })).toBeNull();
+    expect(resolveTarget(`${YT}/@x/streams`, { '@x': 'posts' })).toBeNull();
+  });
+});
+
+describe('resolveTarget com o canal anterior da aba', () => {
+  it('não redireciona quando o usuário clica em Início dentro do mesmo canal', () => {
+    expect(resolveTarget(`${YT}/@x`, {}, '@x')).toBeNull();
+  });
+
+  it('compara o canal anterior ignorando maiúsculas e codificação', () => {
+    expect(resolveTarget(`${YT}/@x`, {}, '@X')).toBeNull();
+    expect(resolveTarget(`${YT}/@caf%C3%A9`, {}, '@CAF%C3%89')).toBeNull();
+  });
+
+  it('redireciona quando veio de outro canal', () => {
+    expect(resolveTarget(`${YT}/@x`, {}, '@y')).toBe(`${YT}/@x/videos`);
+  });
+
+  it.each([undefined, null, ''])('redireciona quando o canal anterior é %j', (previous) => {
+    expect(resolveTarget(`${YT}/@x`, {}, previous)).toBe(`${YT}/@x/videos`);
+  });
+});
diff --git a/tests/unit/rules.test.ts b/tests/unit/rules.test.ts
new file mode 100644
index 0000000..f0de1d1
--- /dev/null
+++ b/tests/unit/rules.test.ts
@@ -0,0 +1,136 @@
+import { describe, expect, it } from 'vitest';
+import type { Preferences } from '@/lib/preferences';
+import { resolveTarget } from '@/lib/redirect';
+import { BASE_RULE_ID, buildRules } from '@/lib/rules';
+import { applyRules } from '@/tests/helpers/dnr';
+
+const YT = 'https://www.youtube.com';
+
+describe('buildRules', () => {
+  it('sem preferências gera só a regra base, que leva para Vídeos', () => {
+    const rules = buildRules({});
+    expect(rules).toHaveLength(1);
+    expect(rules[0]).toMatchObject({
+      id: BASE_RULE_ID,
+      priority: 1,
+      action: {
+        type: 'redirect',
+        redirect: { regexSubstitution: 'https://www.youtube.com/\\1/videos\\2' },
+      },
+      condition: { resourceTypes: ['main_frame'], isUrlFilterCaseSensitive: false },
+    });
+  });
+
+  it('canal em Vídeos não ganha regra própria', () => {
+    expect(buildRules({ '@x': 'videos' })).toHaveLength(1);
+  });
+
+  it('canal com outra aba ganha uma regra de prioridade maior que a base', () => {
+    const rules = buildRules({ '@kipperdev': 'streams' });
+    expect(rules).toHaveLength(2);
+    const [base, channel] = rules;
+    expect(channel?.priority).toBeGreaterThan(base?.priority ?? Infinity);
+    expect(channel?.action).toEqual({
+      type: 'redirect',
+      redirect: { regexSubstitution: 'https://www.youtube.com/\\1/streams\\2' },
+    });
+    expect(channel?.condition.regexFilter).toContain('@kipperdev');
+  });
+
+  it('canal com Início ganha uma regra que só permite', () => {
+    const rules = buildRules({ '@x': 'home' });
+    expect(rules).toHaveLength(2);
+    expect(rules[1]?.action).toEqual({ type: 'allow' });
+  });
+
+  it('gera ids únicos a partir de 1', () => {
+    const rules = buildRules({ '@a': 'streams', '@b': 'home', '@c': 'posts', '@d': 'store' });
+    const ids = rules.map((rule) => rule.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    expect(Math.min(...ids)).toBe(1);
+  });
+
+  it('gera o mesmo resultado qualquer que seja a ordem das preferências', () => {
+    const one: Preferences = { '@a': 'streams', '@b': 'home', '@c': 'posts' };
+    const other: Preferences = { '@c': 'posts', '@a': 'streams', '@b': 'home' };
+    expect(buildRules(one)).toEqual(buildRules(other));
+  });
+
+  it('ignora chaves que não estão normalizadas', () => {
+    expect(buildRules({ '@KipperDev': 'streams' })).toHaveLength(1);
+    expect(buildRules({ kipperdev: 'streams' })).toHaveLength(1);
+  });
+
+  it('ignora valores inválidos', () => {
+    expect(buildRules({ '@x': 'nope' } as unknown as Preferences)).toHaveLength(1);
+  });
+
+  it('trata o ponto do handle como ponto, não como curinga', () => {
+    const rules = buildRules({ '@a.b': 'courses' });
+    expect(applyRules(rules, `${YT}/@a.b`)).toBe(`${YT}/@a.b/courses`);
+    expect(applyRules(rules, `${YT}/@axb`)).toBe(`${YT}/@axb/videos`);
+  });
+});
+
+describe('regras e resolveTarget concordam', () => {
+  const prefs: Preferences = {
+    '@x': 'streams',
+    '@y': 'home',
+    '@café': 'posts',
+    '@a.b': 'courses',
+    '@ab': 'store',
+  };
+  const rules = buildRules(prefs);
+
+  const urls = [
+    `${YT}/@x`,
+    `${YT}/@x/`,
+    `${YT}/@x/featured`,
+    `${YT}/@x/featured/`,
+    `${YT}/@X`,
+    `${YT}/@x?si=abc`,
+    `${YT}/@x/?si=abc`,
+    `${YT}/@x/featured?si=abc&view=0`,
+    `${YT}/@x#topo`,
+    `${YT}/@x/videos`,
+    `${YT}/@x/streams`,
+    `${YT}/@x/about`,
+    `${YT}/@x/featured/extra`,
+    `${YT}/@xy`,
+    `${YT}/@y`,
+    `${YT}/@Y/featured`,
+    `${YT}/@y/videos`,
+    `${YT}/@z`,
+    `${YT}/@z/featured?si=abc`,
+    `${YT}/@z/videos`,
+    `${YT}/@caf%C3%A9`,
+    `${YT}/@caf%c3%a9`,
+    `${YT}/@CAF%C3%89/featured`,
+    `${YT}/@a.b`,
+    `${YT}/@axb`,
+    `${YT}/@ab`,
+    `${YT}/@abc`,
+    `${YT}/watch?v=abc`,
+    `${YT}/shorts/abc`,
+    `${YT}/`,
+    `${YT}/channel/UCabc`,
+    'https://m.youtube.com/@x',
+    'https://example.com/@x',
+  ];
+
+  it.each(urls)('%s', (url) => {
+    expect(applyRules(rules, url)).toBe(resolveTarget(url, prefs));
+  });
+
+  it('confere resultados conhecidos, para as duas camadas não errarem juntas', () => {
+    expect(applyRules(rules, `${YT}/@x`)).toBe(`${YT}/@x/streams`);
+    expect(applyRules(rules, `${YT}/@x?si=abc`)).toBe(`${YT}/@x/streams?si=abc`);
+    expect(applyRules(rules, `${YT}/@y`)).toBeNull();
+    expect(applyRules(rules, `${YT}/@z`)).toBe(`${YT}/@z/videos`);
+    expect(applyRules(rules, `${YT}/@caf%c3%a9`)).toBe(`${YT}/@caf%c3%a9/posts`);
+    expect(applyRules(rules, `${YT}/@CAF%C3%89`)).toBe(`${YT}/@CAF%C3%89/posts`);
+    expect(applyRules(rules, `${YT}/@ab`)).toBe(`${YT}/@ab/store`);
+    expect(applyRules(rules, `${YT}/@abc`)).toBe(`${YT}/@abc/videos`);
+    expect(applyRules(rules, `${YT}/@x/videos`)).toBeNull();
+  });
+});
