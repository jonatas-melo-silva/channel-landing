new file mode 100644
index 0000000..b2310d4
--- /dev/null
+++ b/lib/tab-redirect.ts
@@ -0,0 +1,42 @@
+import { decideNavigation } from './navigation';
+import { loadPreferences } from './storage';
+import { getTabChannel, setTabChannel } from './tab-state';
+
+/**
+ * Leva a aba para `url` trocando a entrada atual do histórico (`location.replace`), para o
+ * botão Voltar não cair de novo na página de entrada do canal e ser redirecionado outra vez.
+ * Se não der para injetar o script, navega pela API de abas.
+ */
+export async function redirectTab(tabId: number, url: string): Promise<void> {
+  try {
+    await browser.scripting.executeScript({
+      target: { tabId },
+      func: (target: string) => {
+        location.replace(target);
+      },
+      args: [url],
+    });
+  } catch {
+    await browser.tabs.update(tabId, { url });
+  }
+}
+
+/**
+ * Trata uma navegação da aba. `source` diz de onde veio o evento: `history` é a navegação
+ * interna do YouTube (troca a URL sem recarregar) e `load` é uma carga completa de página.
+ * Só na navegação interna importa o canal anterior: clicar em Início dentro do canal não
+ * deve ser desfeito. Numa carga completa a pessoa veio de fora, então o canal anterior
+ * não conta.
+ */
+export async function handleNavigation(
+  tabId: number,
+  url: string,
+  source: 'history' | 'load',
+): Promise<void> {
+  const [prefs, remembered] = await Promise.all([loadPreferences(), getTabChannel(tabId)]);
+  const previousChannel = source === 'history' ? remembered : null;
+
+  const { redirectTo, channel } = decideNavigation(url, prefs, previousChannel);
+  await setTabChannel(tabId, channel);
+  if (redirectTo !== null) await redirectTab(tabId, redirectTo);
+}
diff --git a/lib/tab-state.ts b/lib/tab-state.ts
new file mode 100644
index 0000000..838c1bd
--- /dev/null
+++ b/lib/tab-state.ts
@@ -0,0 +1,37 @@
+const STORAGE_KEY = 'tabChannels';
+
+/** Canal (chave normalizada) em que cada aba estava na última navegação, por id da aba. */
+type TabChannels = Record<string, string>;
+
+// O service worker é encerrado quando fica ocioso, então o estado vai para storage.session,
+// que dura até o navegador fechar e nunca é gravado em disco.
+async function read(): Promise<TabChannels> {
+  const stored = await browser.storage.session.get(STORAGE_KEY);
+  const raw: unknown = stored[STORAGE_KEY];
+  if (typeof raw !== 'object' || raw === null || Array.isArray(raw)) return {};
+
+  const result: TabChannels = {};
+  for (const [tabId, channel] of Object.entries(raw)) {
+    if (typeof channel === 'string') result[tabId] = channel;
+  }
+  return result;
+}
+
+export async function getTabChannel(tabId: number): Promise<string | null> {
+  return (await read())[String(tabId)] ?? null;
+}
+
+/** Lembra o canal da aba. Com `null`, esquece a aba (ela saiu de qualquer canal). */
+export async function setTabChannel(tabId: number, channel: string | null): Promise<void> {
+  const channels = await read();
+  if (channel === null) {
+    delete channels[String(tabId)];
+  } else {
+    channels[String(tabId)] = channel;
+  }
+  await browser.storage.session.set({ [STORAGE_KEY]: channels });
+}
+
+export function clearTabChannel(tabId: number): Promise<void> {
+  return setTabChannel(tabId, null);
+}
