+import { parseChannelUrl } from './handle';
+import type { Preferences } from './preferences';
+import { resolveTarget } from './redirect';
+
+export interface NavigationDecision {
+  /** Para onde levar a aba, ou null para deixar como está. */
+  redirectTo: string | null;
+  /** Canal da URL atual (chave normalizada), para lembrar como canal anterior da aba. */
+  channel: string | null;
+}
+
+/**
+ * Decide o que fazer quando uma aba navega para `url`. `previousChannel` é o canal em que a
+ * aba estava antes, ou null se estava fora de um canal (ou se é uma carga completa de página).
+ */
+export function decideNavigation(
+  url: string,
+  prefs: Preferences,
+  previousChannel: string | null,
+): NavigationDecision {
+  return {
+    redirectTo: resolveTarget(url, prefs, previousChannel),
+    channel: parseChannelUrl(url)?.key ?? null,
+  };
+}
diff --git a/lib/serial-queue.ts b/lib/serial-queue.ts
new file mode 100644
index 0000000..29ee3a0
--- /dev/null
+++ b/lib/serial-queue.ts
@@ -0,0 +1,17 @@
+/**
+ * Fila que executa uma tarefa por vez, na ordem em que chegam. O background recebe vários
+ * eventos quase juntos e várias tarefas leem e depois gravam o mesmo storage, então rodar
+ * em paralelo poderia perder uma atualização. Uma tarefa que falha é reportada em `onError`
+ * e não impede as seguintes.
+ */
+export function createSerialQueue(
+  onError: (error: unknown) => void = (error) => console.error(error),
+) {
+  let tail: Promise<void> = Promise.resolve();
+
+  return (task: () => Promise<void>): Promise<void> => {
+    const next = tail.then(task).catch(onError);
+    tail = next;
+    return next;
+  };
+}
